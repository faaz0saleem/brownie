# Fudgio — Apache/LiteSpeed config for Hostinger shared hosting.
RewriteEngine On

# --- Route all /api/* requests to the PHP front controller ---
RewriteRule ^api/?$      api/index.php  [L]
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api/(.*)$   api/index.php  [L,QSA]

# --- Serve index.html for the site root (fixes the 403 / stray admin redirect) ---
DirectoryIndex index.html index.php

# --- Protect sensitive files (never serve these) ---
<FilesMatch "^\.env|\.(git|md|json|lock)$|^(package|package-lock)\.json$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.env
RedirectMatch 404 /src/
RedirectMatch 404 /node_modules/

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compression & caching ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
