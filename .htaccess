# Fudgio — Apache/LiteSpeed config for Hostinger shared hosting.
Options -Indexes
RewriteEngine On

# --- Route all /api/* requests to the PHP front controller ---
RewriteRule ^api/?$      api/index.php  [L]
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api/(.*)$   api/index.php  [L,QSA]

# --- Never redirect the main domain to admin; serve the store at root ---
RewriteCond %{HTTP_HOST} ^(www\.)?fudgio\.com$ [NC]
RewriteRule ^$ index.html [L]

# --- Clean URLs: redirect /page.html -> /page (professional URLs) ---
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Internally serve /page from page.html ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html index.php

# --- Protect sensitive files ---
<FilesMatch "(^\.env|^\.|\.(git|md|lock|sqlite|db|ini|log|bak|sql|yml|yaml)$|package(-lock)?\.json$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.env
RedirectMatch 404 ^/(src|node_modules|data|\.git|scripts|tests)/
# Block anything trying to reach the SQLite data file directly.
RedirectMatch 404 \.sqlite$

# --- Block obvious probe traffic / injection attempts in the query string ---
RewriteCond %{QUERY_STRING} (\.\./|<script|%3Cscript|union[\s+]+select|base64_decode\() [NC]
RewriteRule .* - [F,L]
# Common WordPress/PHP scanner paths — this site has none of them.
RewriteRule ^(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|\.env\.) - [F,L,NC]

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Content Security Policy. The pages use inline <script>/<style> blocks, so
  # 'unsafe-inline' is required; no external scripts are allowed at all.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; connect-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header unset X-Powered-By
  Header always unset Server
  # HTML must never be cached: it names the exact asset version it needs.
  # The assets themselves carry a ?v=<hash> so a new deploy is always a new URL
  # and can be cached hard. This pairing is what stops a browser holding an old
  # store.js against new HTML — which is how the shop once rendered no brownies.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# LiteSpeed (Hostinger) caches pages by default; keep HTML and the API live.
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
