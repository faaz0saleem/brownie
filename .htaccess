# Fudgio — Apache/LiteSpeed config for Hostinger shared hosting.
Options -Indexes
RewriteEngine On

# --- Route all /api/* requests to the PHP front controller ---
RewriteRule ^api/?$      api/index.php  [L]
RewriteCond %{REQUEST_URI} !^/api/index\.php
RewriteRule ^api/(.*)$   api/index.php  [L,QSA]

# --- Never redirect the main domain to admin; serve the store at root ---
RewriteCond %{HTTP_HOST} ^(www\.)?fudgio\.com$ [NC]
RewriteRule ^$ index.html [L]

# --- Clean URLs: redirect /page.html -> /page (professional URLs) ---
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Internally serve /page from page.html ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html index.php

# --- Protect sensitive files ---
<FilesMatch "(^\.env|\.(git|md|lock)$|package(-lock)?\.json$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.env
RedirectMatch 404 ^/(src|node_modules)/

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "index\.html$">
    Header always set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
