# ======================================================================
# Fudgio configuration — copy this file to `.env` and fill in real values.
# NEVER commit your real .env file. It is git-ignored for a reason.
# ======================================================================

# ---- Ports ----
SHOP_PORT=4000
ADMIN_PORT=3000

# ---- Brand / contact (shown on the site) ----
BRAND_NAME=Fudgio
SITE_DOMAIN=fudgio.com
ADMIN_DOMAIN=admin.fudgio.com
SITE_URL=https://fudgio.com
CONTACT_EMAIL=faaz.saleem@fudgio.com
CONTACT_PHONE=+92 300 0000000
CONTACT_ADDRESS=Karachi, Pakistan
BRAND_INSTAGRAM=https://instagram.com/fudgio
CURRENCY=Rs
FREE_DELIVERY_OVER=2500
DELIVERY_FEE=150

# ---- Admin dashboard password (admin.fudgio.com) ----
# Use a long, random value in production.
ADMIN_TOKEN=Faaz12345

# ---- Lock the admin to your IP(s) only (comma-separated). ----
# Leave blank to allow any IP (password still required). Find your IP at
# https://whatismyipaddress.com and put it here to block everyone else.
ADMIN_ALLOW_IP=

# ---- Session cookie signing secret (REQUIRED in production) ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=change-this-to-a-long-random-string
SESSION_DAYS=30

# ---- Database (Google Cloud SQL for MySQL) ----
# Leave DB_HOST blank to use the built-in JSON file store (local dev only).
# For production, point this at your Cloud SQL instance.
DB_HOST=
DB_PORT=3306
DB_USER=fudgio
DB_PASSWORD=
DB_NAME=fudgio
# Cloud SQL public IP should use SSL:
DB_SSL=true

# ---- Google Sign-In (OAuth) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  https://fudgio.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fudgio.com/auth/google/callback

# ---- Order notifications (get alerted the moment an order is placed) ----
# Email via any SMTP provider (Gmail app password, Zoho, Mailgun, SendGrid...).
# Leave SMTP_HOST blank to disable email (orders still appear in the admin).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=faaz.saleem@fudgio.com
ORDER_NOTIFY_TO=faaz.saleem@fudgio.com
# Optional: POST each new order to a webhook (WhatsApp Cloud API relay, Zapier,
# Make, n8n, Slack/Discord webhook, etc.). Leave blank to disable.
ORDER_WEBHOOK_URL=

# ---- reCAPTCHA Enterprise ----
# The site key is public and can be embedded in storefront pages.
RECAPTCHA_SITE_KEY=6Le46WctAAAAABH4t6WKQyiL8jy0YximSYWsRzV5
# Set both values below to enforce server-side assessments.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=0.5

NODE_ENV=production
