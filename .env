# ======================================================================
# Fudgio — live configuration
# ======================================================================
# ⚠️  SECURITY: this file is COMMITTED and the repository is public, so
# anything written here is published on GitHub — and every git deploy
# overwrites this file on the server anyway.
#
# Passwords go in `.env.local` on the server instead. That file is
# git-ignored, is never deployed, and its values override this one.
# See .env.local.example for the exact contents.
# ======================================================================

# ---- Brand / contact ----
BRAND_NAME=Fudgio
SITE_URL=https://fudgio.com
ADMIN_DOMAIN=admin.fudgio.com
CONTACT_EMAIL=dev@solutioninn.com
CURRENCY=Rs

# ---- Delivery ----
DELIVERY_CITY=Lahore
DELIVERY_FEE=150
FREE_DELIVERY_OVER=2500

# ---- Admin dashboard ----
ADMIN_TOKEN=Faaz12345
# Lock the admin to your IP(s), comma-separated. Find yours at
# https://whatismyipaddress.com — leave blank to allow any IP (password still required).
ADMIN_ALLOW_IP=

# ---- Order alerts (emails you when an order arrives) ----
ORDER_NOTIFY_TO=dev@solutioninn.com

# ---- Outgoing email (checkout verification codes + order alerts) ----
# These send from your real mailbox so codes don't look like spam.
# Hostinger mailbox settings: host smtp.hostinger.com, port 587, TLS.
# ⚠️  SMTP_PASS goes in public_html/.env.local on the server — never here.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=faaz.saleem@fudgio.com
SMTP_PASS=Faaz12345
SMTP_FROM=faaz.saleem@fudgio.com

# ---- Anti-abuse limits (silent — never shown on the site) ----
MAX_QTY_PER_ITEM=20
MAX_UNITS_PER_ORDER=30
MAX_ORDER_VALUE=50000

# ---- Database ----
# Leave DB_HOST blank to keep using the safe SQLite file stored OUTSIDE
# public_html (survives deploys). To switch to Google Cloud SQL, set BOTH
# DB_HOST and DB_PASSWORD in public_html/.env.local on the server.
# Setting the password without the host does nothing — the site stays on SQLite.
DB_HOST=
DB_PORT=3306
DB_USER=fudgio_app
DB_PASSWORD=Faaz12345!
DB_NAME=fudgio
DB_SSL=true
