# ======================================================================
# Fudgio — live configuration
# ======================================================================
# ⚠️  SECURITY: this file is committed so it deploys with your site, so it
# must contain NO real passwords. Add DB_PASSWORD directly on the server
# (hPanel → File Manager → public_html/.env) — never commit it.
# ======================================================================

# ---- Brand / contact ----
BRAND_NAME=Fudgio
SITE_URL=https://fudgio.com
ADMIN_DOMAIN=admin.fudgio.com
CONTACT_EMAIL=dev@solutioninn.com
CURRENCY=Rs

# ---- Delivery ----
DELIVERY_CITY=Lahore
DELIVERY_FEE=150
FREE_DELIVERY_OVER=2500

# ---- Admin dashboard ----
ADMIN_TOKEN=Faaz12345
# Lock the admin to your IP(s), comma-separated. Find yours at
# https://whatismyipaddress.com — leave blank to allow any IP (password still required).
ADMIN_ALLOW_IP=

# ---- Order alerts (emails you when an order arrives) ----
ORDER_NOTIFY_TO=dev@solutioninn.com

# ---- Database ----
# Leave DB_HOST blank to keep using the safe SQLite file stored OUTSIDE
# public_html (survives deploys). To switch to Google Cloud SQL, fill these
# in ON THE SERVER (do not commit the password):
DB_HOST=
DB_PORT=3306
DB_USER=fudgio_app
DB_PASSWORD=
DB_NAME=fudgio
DB_SSL=true
