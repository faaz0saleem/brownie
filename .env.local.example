# ======================================================================
# Fudgio — SERVER SECRETS.  Copy this to `.env.local` on the server only.
# ======================================================================
#
#   hPanel → File Manager → public_html → New File → .env.local
#
# Why a second file:
#   `.env` is committed to the repository, so anything written in it is
#   published on GitHub, and every git deploy overwrites it on the server.
#   `.env.local` is git-ignored, never deployed, and its values override
#   `.env`. Passwords belong here and nowhere else.
#
# This file (.env.local.example) is only a template — it holds no real
# values and is safe to commit. Do NOT rename it in the repository.
# ======================================================================

# Password for the faaz.saleem@fudgio.com mailbox (sends verification codes)
SMTP_PASS=

# Google Cloud SQL. The site stays on the safe SQLite file until DB_HOST is
# set, so fill in BOTH of these or neither.
DB_HOST=
DB_PASSWORD=
